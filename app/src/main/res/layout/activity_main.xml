<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera preview (under the face) -->
    <!-- IMPORTANT: Keep it VISIBLE so CameraX always has a live surface. -->
    <!-- We hide it with alpha instead of visibility=invisible. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.01"
        android:importantForAccessibility="no" />

    <!-- Scout face overlay -->
    <com.example.scoutface.ScoutFaceView
        android:id="@+id/faceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Swipe-right hint (shown once on first launch, added/removed programmatically) -->
    <FrameLayout
        android:id="@+id/hintContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:importantForAccessibility="no" />

    <!-- Closed captions for hearing impaired (toggled in Settings) -->
    <TextView
        android:id="@+id/captionsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="#CC000000"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:lineSpacingMultiplier="1.25"
        android:visibility="gone"
        android:importantForAccessibility="yes"
        android:contentDescription="Scout caption" />

</FrameLayout>
