        android:strokeColor="#0D47A1"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M10,20 C10,0 90,0 90,20 C90,40 10,40 10,20 Z" />

