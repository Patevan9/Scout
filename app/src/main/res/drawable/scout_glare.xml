<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Soft Reflection (Top Left) -->
    <item
        android:top="15dp"
        android:left="15dp"
        android:right="50dp"
        android:bottom="50dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="20dp"
                />
        </shape>
    </item>

    <!-- 2. The Sharp Shine Dot -->
    <item
        android:top="25dp"
        android:left="25dp"
        android:right="70dp"
        android:bottom="70dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>