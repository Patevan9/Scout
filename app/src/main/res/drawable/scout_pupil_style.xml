<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. The Main Black Pupil Circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>

    <!-- 2. The "Glint" (The shiny white reflection) -->
    <!-- We offset this to the top-left corner so it looks like light hitting glass -->
    <item
        android:top="15dp"
        android:left="15dp"
        android:right="50dp"
        android:bottom="50dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="radial"
                android:gradientRadius="20dp"
                />
        </shape>
    </item>

    <!-- 3. A tiny sharp white dot for extra shine -->
    <item
        android:top="20dp"
        android:left="20dp"
        android:right="60dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>